{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_OIDC_TOKEN",
    "VERCEL_URL",
    "NEXT_PUBLIC_VERCEL_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_MAPTILER_KEY",
    "NEXT_PUBLIC_MAPTILER_STYLE",
    "NEXT_PUBLIC_MAP_PRUNE",
    "NEXT_PUBLIC_API_BASE_URL",
    "MOBILE_API_BASE_URL",
    "ALLOWED_FRONTEND_ORIGIN",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "NEXT_PUBLIC_BETA_AI_SEARCH",
    "NEXT_PUBLIC_BETA_EASTER_EGGS",
    "NEXT_PUBLIC_BETA_LIVE_LOCATION",
    "NEXT_PUBLIC_CONTRIBUTOR_THEME",
    "NEXT_PUBLIC_CONTRIBUTOR_THEME_ENABLED",
    "CC_ENABLE_EMBEDDINGS",
    "OPENAI_API_KEY",
    "CONNECT_API_BASE_URL",
    "CONNECT_BASE_URL",
    "CONNECT_API_KEY",
    "CONNECT_MODE",
    "PAYFAST_MERCHANT_ID",
    "PAYFAST_MERCHANT_KEY",
    "PAYFAST_PASSPHRASE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/**", "mobile-dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["playwright-report/**"]
    }
  }
}
