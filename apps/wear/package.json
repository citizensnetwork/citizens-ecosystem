{
  "name": "@citizens/wear",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:frontend": "python -m http.server 3001 --directory src/frontend",
    "build": "node scripts/build-frontend.js && next build",
    "build:frontend": "node scripts/build-frontend.js",
    "build:mobile": "node scripts/build-frontend.js --mobile",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/app": "~8.1.0",
    "@capacitor/browser": "~8.0.3",
    "@capacitor/core": "~8.5.3",
    "@citizens/connect-client": "workspace:*",
    "@citizens/db": "workspace:*",
    "@citizens/utils": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.102.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@citizens/config": "workspace:*",
    "@citizens/frontend-build": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.25.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.5.4",
    "vitest": "^5.0.5"
  }
}
