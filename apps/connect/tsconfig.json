{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    // false, not the create-next-app default: Vercel restores .next/cache (incl.
    // tsbuildinfo) from the *previous* deployment on this lane. When prod's last
    // cache is many commits behind the build being deployed, tsc trusted stale
    // incremental state and threw a phantom "no exported member" on unchanged,
    // valid code (2026-09-26 prod build of PR #63 — passed on every preview build
    // of the identical tree, and locally, because those caches stayed self-consistent).
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/frontend"
  ]
}
