{
  "name": "citizens-hub",
  "version": "0.0.0",
  "private": true,
  "description": "The front door of the shared Citizens domain: the /citizens landing page, the coming-soon pages and the rewrites that serve each app at /citizens/<app>.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src config test scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "proof:proxy": "node scripts/proxy-proof.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@citizens/config": "workspace:*",
    "@citizens/ecosystem": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "typescript": "5.5.4",
    "vitest": "^5.0.5"
  }
}
