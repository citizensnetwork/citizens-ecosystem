{
  "name": "@engine/config",
  "version": "0.0.0",
  "private": true,
  "description": "The tenant configuration contract of the map engine: what the engine owner allows (entitlements), what a tenant chooses (configuration), and the rules that check one against the other. Holds the Citizens configuration and one made-up sample tenant.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./world": "./src/world.ts",
    "./schema": "./src/schema.ts",
    "./citizens": "./src/configs/citizens.ts",
    "./sample": "./src/configs/sample.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@citizens/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.5.4",
    "vitest": "^5.0.5"
  }
}
