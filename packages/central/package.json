{
  "name": "@citizens/central",
  "version": "0.0.0",
  "private": true,
  "description": "The Central feed mechanism: the layout engine, the feed item and app registry contracts, the daily edition (ranking, finite, cursor) and the Connect adapter. Pure TypeScript, no dependencies. Guide: docs/central/CENTRAL_FEED_GUIDE.md.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./layout": "./src/layout.ts",
    "./contract": "./src/contract.ts",
    "./edition": "./src/edition.ts",
    "./adapters/connect": "./src/adapters/connect.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@citizens/config": "workspace:*",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.5.4",
    "vitest": "^5.0.5"
  }
}
