{
  "name": "citizens",
  "version": "0.1.0",
  "private": true,
  "description": "Citizens ecosystem monorepo - Connect (discovery), Vision (impact intelligence), Wear (Kingdom fashion social) on one shared Supabase data plane",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/vercel-ignore.test.mjs && turbo run test",
    "test:coverage": "node --test scripts/vercel-ignore.test.mjs && turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.3.3",
    "turbo": "2.9.14",
    "typescript": "5.5.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": "8.5.23",
      "eslint-config-next>@typescript-eslint/parser": "^8.58.0",
      "eslint-config-next>@typescript-eslint/eslint-plugin": "^8.58.0",
      "vitest@<5.0.5": ">=5.0.5",
      "@vitest/coverage-v8@<5.0.5": ">=5.0.5",
      "@vitest/mocker@<5.0.5": ">=5.0.5",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "js-yaml@>=4.0.0 <=4.1.1": "^5.4.1",
      "@eslint/eslintrc>js-yaml": "^5.4.1",
      "nanoid@<3.3.18": "^3.3.18",
      "next@15.5.18": ">=15.5.28 <16.0.0",
      "next@16.2.6": ">=16.4.1 <17.0.0",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "tar@<7.5.21": "^7.5.21",
      "undici@<7.30.1": "^7.30.1",
      "uuid@<11.1.1": "11.1.1",
      "zod@<4.6.6": "^4.6.6",
      "@xmldom/xmldom@0.9.10": ">=0.9.12",
      "browserslist@4.28.4": ">=4.28.7",
      "baseline-browser-mapping@2.10.41": ">=2.11.0",
      "braces": "link:./packages/braces-patched"
    },
    "packageExtensions": {
      "next": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      }
    }
  }
}
